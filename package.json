{
    "name": "sentry-vir",
    "version": "4.5.4",
    "description": "Easily use Sentry.",
    "keywords": [
        "config",
        "helper",
        "sentry",
        "vir"
    ],
    "homepage": "https://github.com/electrovir/sentry-vir",
    "bugs": {
        "url": "https://github.com/electrovir/sentry-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/sentry-vir.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "build": "virmator frontend build",
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "virmator frontend",
        "test": "virmator test web",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,docs,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^32.7.0",
        "@augment-vir/common": "^32.7.0",
        "@sentry/browser": "^11.11.0",
        "@sentry/core": "^11.11.0",
        "@sentry/node": "^11.11.0",
        "date-vir": "^9.4.1",
        "fuzzy-vir": "^1.0.0"
    },
    "devDependencies": {
        "@augment-vir/test": "^32.7.0",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@web/dev-server-esbuild": "^2.0.0",
        "@web/test-runner": "^1.0.0",
        "@web/test-runner-commands": "^1.0.1",
        "@web/test-runner-playwright": "^1.0.0",
        "@web/test-runner-visual-regression": "^1.0.1",
        "cspell": "^10.4.1",
        "dependency-cruiser": "^18.7.2",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^65.4.5",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.12.2",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-unicorn": "^79.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.1.2",
        "npm-check-updates": "^23.1.1",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.1.0",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^4.1.0",
        "runstorm": "^1.1.1",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "virmator": "^14.38.0",
        "vite": "^8.3.6"
    },
    "engines": {
        "node": ">=22"
    }
