{
    "name": "sentry-vir",
    "version": "3.1.1",
    "description": "Easily use Sentry.",
    "keywords": [
        "config",
        "helper",
        "sentry",
        "vir"
    ],
    "homepage": "https://github.com/electrovir/sentry-vir",
    "bugs": {
        "url": "https://github.com/electrovir/sentry-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/sentry-vir.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "scripts": {
        "build": "virmator frontend build",
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "virmator frontend",
        "test": "virmator test web",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,docs,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.32.2",
        "@augment-vir/common": "^31.32.2",
        "@sentry/browser": "^10.5.0",
        "@sentry/core": "^10.5.0",
        "@sentry/node": "^10.5.0",
        "type-fest": "^4.41.0"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.32.2",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.33.0",
        "@stylistic/eslint-plugin": "^5.2.3",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@typescript-eslint/eslint-plugin": "^8.39.1",
        "@web/dev-server-esbuild": "^1.0.4",
        "@web/test-runner": "^0.20.2",
        "@web/test-runner-commands": "^0.9.0",
        "@web/test-runner-playwright": "^0.11.1",
        "@web/test-runner-visual-regression": "^0.10.0",
        "cspell": "^9.2.0",
        "dependency-cruiser": "^17.0.1",
        "esbuild": "^0.25.9",
        "eslint": "^9.33.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^54.1.0",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.2.2",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.4",
        "eslint-plugin-unicorn": "^57.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.3",
        "npm-check-updates": "^18.0.2",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.3.3",
        "prettier-plugin-multiline-arrays": "^4.0.3",
        "prettier-plugin-organize-imports": "^4.2.0",
        "prettier-plugin-packagejson": "^2.5.19",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.6",
        "typedoc": "^0.28.10",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.39.1",
        "virmator": "^13.16.2",
        "vite": "^7.1.2"
    },
    "engines": {
        "node": ">=22"
    }
}
